# Supabase: use a connection string do botão Connect.
# Para Render, prefira o pooler IPv4/session mode se o painel fornecer essa opção.
DATABASE_URL=postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres?sslmode=require

# Senha do painel da médica. Troque por uma senha forte.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Token longo usado somente no endereço da TV.
TV_TOKEN=troque-por-um-token-aleatorio-longo

# Opcional: ambiente de produção.
FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-secreta-longa
